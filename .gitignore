# ── 依赖 ──
node_modules/

# ── 运行时生成的数据库（由 db/seed.js 自动重建，seed 脚本本身保留纳管）──
db/*.db
db/*.sqlite
db/*.sqlite3

# ── 环境变量（保留 .env.example 模板）──
.env
.env.local
.env.*.local

# ── 日志 ──
logs/
*.log
npm-debug.log*

# ── 系统与编辑器 ──
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# ── 运行时临时文件 ──
*.tmp
coverage/
dist/
